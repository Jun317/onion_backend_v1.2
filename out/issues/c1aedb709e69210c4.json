 "glossary": [
  {
   "term": "주식",
   "easy": "회사의 소유권 일부를 나타내는 증권이에요.",
   "example": "주식을 사면 그 회사의 주인이 되는 거예요."
  },
  {
   "term": "매수",
   "easy": "물건이나 주식을 사는 것을 말해요.",
   "example": "주식 시장이 좋을 때 매수하는 것이 보통 유리해요."
  },
  {
   "term": "보유",
   "easy": "주식이나 자산을 계속 가지고 있는 것을 말해요.",
   "example": "주가 상승을 기대하며 주식을 계속 보유할 수 있어요."
  },
  {
   "term": "매도",
   "easy": "물건이나 주식을 파는 것을 말해요.",
   "example": "주가가 많이 올랐을 때 매도하면 이익을 얻을 수 있어요."
  }
 ],
